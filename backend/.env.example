# Server
PORT=9381
HOST=localhost

# CORS
CORS_ORIGIN=http://localhost:9380

# Database
DB_PATH=./data/crewdeck.db

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./data/server.log

# Agent Runtime
TMUX_POLL_INTERVAL=100
PROCESS_MONITOR_INTERVAL=5000
AGENT_KILL_TIMEOUT=5000

# Docker Path Translation (only needed when running in Docker)
# CREWDECK_REPOS_HOST_PATH=/home/user/projects
# CREWDECK_REPOS_CONTAINER_PATH=/repos

# Google OAuth (required for authentication)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=change-me-in-production

# Email allowlist (optional, comma-separated, restricts access if set)
# ALLOWED_EMAILS=user1@example.com,user2@example.com
