    "node-pty": "^1.1.0",
    "pino": "^9.1.0",
    "pino-http": "^10.2.0",
    "pino-roll": "^4.0.0",
    "ws": "^8.18.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.10",
    "pino-pretty": "^11.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.3",
    "vitest": "^1.4.0"
