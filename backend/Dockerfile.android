FROM node:22-bookworm

# ── System dependencies ─────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    tmux \
    git \
    python3 \
    make \
    g++ \
    unzip \
    wget \
    openjdk-17-jdk-headless \
    cmake \
    autoconf automake libtool \
    perl \
  && rm -rf /var/lib/apt/lists/*

# GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
  && apt-get update && apt-get install -y --no-install-recommends gh \
  && rm -rf /var/lib/apt/lists/*

# ── Go ───────────────────────────────────────────────────────────────
ENV GO_VERSION=1.24.2
RUN wget -q https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz -O /tmp/go.tar.gz \
  && tar -C /usr/local -xzf /tmp/go.tar.gz \
  && rm /tmp/go.tar.gz
ENV PATH="/usr/local/go/bin:/root/go/bin:${PATH}"
ENV GOPATH="/root/go"

# gomobile + gobind
RUN go install golang.org/x/mobile/cmd/gomobile@latest \
  && go install golang.org/x/mobile/cmd/gobind@latest \
  && gomobile init

# ── Android SDK ──────────────────────────────────────────────────────
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=${ANDROID_HOME}
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}"

RUN mkdir -p ${ANDROID_HOME}/cmdline-tools \
  && wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O /tmp/cmdline-tools.zip \
  && unzip -q /tmp/cmdline-tools.zip -d ${ANDROID_HOME}/cmdline-tools \
  && mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest \
  && rm /tmp/cmdline-tools.zip

# Accept licenses and install SDK components
RUN yes | sdkmanager --licenses > /dev/null 2>&1 \
  && sdkmanager --install \
    "platforms;android-35" \
    "build-tools;35.0.0" \
    "ndk;30.0.14904198" \
    "platform-tools"

ENV ANDROID_NDK_HOME=${ANDROID_HOME}/ndk/30.0.14904198

# ── Claude Code CLI ──────────────────────────────────────────────────
RUN npm install -g @anthropic-ai/claude-code

# ── App user ─────────────────────────────────────────────────────────
RUN groupadd -r app && useradd -r -g app -m -s /bin/bash app

# Make Go and gomobile available to app user
RUN cp -r /root/go/bin/* /usr/local/bin/ \
  && mkdir -p /home/app/go \
  && chown -R app:app /home/app/go
ENV GOPATH="/home/app/go"

WORKDIR /app

# Install backend dependencies
COPY backend/package.json backend/package-lock.json* backend/
RUN cd backend && npm ci

# Copy backend source and build
COPY backend/ backend/
RUN cd backend && npm run build

# Ensure data directories exist and app user can write to them
RUN mkdir -p /app/data /app/backend/data \
    && chown app:app /app/data /app/backend/data

# Copy host ~/.claude so the container has a writable, independent copy.
COPY --from=claude-config --chown=app:app / /home/app/.claude/

# Restore .claude.json from backup if the host didn't provide it directly.
RUN latest=$(ls -t /home/app/.claude/backups/.claude.json.backup.* 2>/dev/null | head -1) \
    && if [ -n "$latest" ]; then cp "$latest" /home/app/.claude.json && chown app:app /home/app/.claude.json; fi

USER app

ENV HOST=0.0.0.0
ENV PORT=3000

EXPOSE 3000

WORKDIR /app/backend

CMD ["node", "dist/index.js"]
